<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.UzunsIPTV" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorOnPrimary">@color/login_button_text</item>
        <item name="colorSecondary">@color/app_accent_deep</item>
        <item name="colorOnSecondary">@color/app_text_primary</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Keep portrait headers below the status bar on Android 15. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
    </style>
</resources>
