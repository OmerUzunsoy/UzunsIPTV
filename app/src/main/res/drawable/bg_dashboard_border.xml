<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#337FA9A3" /> <stroke android:width="2dp" android:color="@color/app_focus" /> <corners android:radius="20dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D7FA9A3" />
            <stroke android:width="2dp" android:color="@color/app_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" /> <stroke android:width="0dp" android:color="#00000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
