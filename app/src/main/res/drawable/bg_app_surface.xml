<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/app_bg_secondary"
                android:centerColor="@color/app_bg"
                android:endColor="#070B10" />
        </shape>
    </item>
    <item android:top="-140dp" android:left="-100dp" android:right="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerColor="#263F5B72"
                android:endColor="#000B1017" />
        </shape>
    </item>
    <item android:bottom="-180dp" android:right="-120dp" android:left="140dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:centerColor="#247FA9A3"
                android:endColor="#000B1017" />
        </shape>
    </item>
</layer-list>
