<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_accent"/>
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/app_focus" />
        </shape>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/app_focus"/>
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/app_accent_strong"/>
                    <corners android:radius="18dp" />
                    <stroke android:width="2dp" android:color="@color/app_focus" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/app_accent_strong"
                android:endColor="@color/app_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
