<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_surface"
    tools:context=".VodDetailsActivity">

    <ImageView
        android:id="@+id/imgBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:alpha="0.28"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_scrim" />

    <LinearLayout
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="20dp"
        android:background="@drawable/bg_universal_selector"
        android:clickable="true"
        android:focusable="true"
        android:nextFocusDown="@id/btnPlayMovie"
        android:layout_margin="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/app_text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LİSTEYE DÖN"
            android:textColor="@color/app_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cardPoster">

        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Film Başlığı"
            android:textColor="@color/app_text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMDB ..."
                android:textColor="@color/login_button_text"
                android:textStyle="bold"
                android:background="@drawable/bg_live_badge"
                android:backgroundTint="@color/app_accent_strong"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>

            <TextView
                android:id="@+id/tvGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tür: ..."
                android:textColor="@color/app_accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Süre: ..."
                android:textColor="@color/app_text_secondary"
                android:textSize="12sp"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detaylar yükleniyor..."
            android:textColor="@color/app_text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:maxLines="6"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvCast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oyuncular: ..."
            android:textColor="@color/app_text_muted"
            android:textSize="13sp"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPlayMovie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İZLE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/login_button_text"
            android:background="@drawable/bg_primary_button"
            android:drawableStart="@android:drawable/ic_media_play"
            android:drawableTint="@color/login_button_text"
            android:paddingHorizontal="22dp"
            android:paddingVertical="14dp"
            android:layout_marginTop="22dp"
            android:nextFocusUp="@id/btnBack"
            android:nextFocusDown="@id/btnPlayMovie"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@id/btnPlayMovie"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardPoster"
        android:layout_width="230dp"
        android:layout_height="345dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgPosterSmall"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
